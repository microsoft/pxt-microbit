{
    "compilerOptions": {
        "target": "es2017",
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "declaration": true,
        "outFile": "../built/sim.js",
        "rootDir": "..",
        "newLine": "LF",
        "moduleResolution": "node",
        "sourceMap": false,
        "lib": [
            "dom",
            "dom.iterable",
            "scripthost",
            "es2017"
        ],
        "types": []
    },
    "include": [
        "*.ts",
        "state/*.ts",
        "visuals/*.ts",
        "../node_modules/pxt-common-packages/libs/base/sim/core/control.ts",
        "../node_modules/pxt-common-packages/libs/base/sim/core/controlmessage.ts",
        "../node_modules/pxt-common-packages/libs/core/sim/core/analogSensor.ts",
        "../node_modules/pxt-common-packages/libs/microphone/sim/core/state.ts",
        "../node_modules/pxt-common-packages/libs/core/sim/neopixel.ts",
        "../node_modules/pxt-common-packages/libs/core/sim/core/neopixelstate.ts",
        "../node_modules/pxt-common-packages/libs/radio/sim/core/*.ts",
        "../node_modules/pxt-common-packages/libs/settings/sim/core/*.ts"
    ]
}
