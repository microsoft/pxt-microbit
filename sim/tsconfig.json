{
    "compilerOptions": {
        "target": "es2017",
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "declaration": true,
        "outFile": "../built/sim.js",
        "rootDir": "..",
        "newLine": "LF",
        "moduleResolution": "node",
        "sourceMap": false,
        "lib": [
            "dom",
            "dom.iterable",
            "scripthost",
            "es2017"
        ],
        "types": []
    },
    "files": [
        "../node_modules/pxt-core/built/pxtsim.d.ts",
        "../built/simcore.d.ts"
    ],
    "include": [
        "visuals/**/*.ts",
        "../node_modules/pxt-common-packages/libs/core/sim/neopixel.ts"
    ],
    "prepend": [
        "../built/simcore.js"
    ]
}
